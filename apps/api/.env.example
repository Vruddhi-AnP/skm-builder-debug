# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT signing secret.
# Production value must be at least 32 characters.
JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters

# Allowed values: development, test, production
NODE_ENV=production

# Public URL of the deployed frontend.
# Used as the allowed CORS origin.
FRONTEND_URL=https://app.example.com

# Optional. Defaults to 4000 when omitted.
PORT=4000
