generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  founder
  investor
  advisor
  admin
}

model User {
  id           String   @id @default(uuid())

  email        String   @unique

  password     String

  refreshToken String?

  name         String?

  role         Role

  createdAt    DateTime @default(now())

  updatedAt    DateTime @updatedAt
  
  founderProfile FounderProfile?

  startups     Startup[] @relation("FounderStartups")
}

model FounderProfile {
  id String @id @default(uuid())

  userId String @unique

  phoneNumber String?

  location String?

  founderRole String?

  startupExperience String?

  linkedinUrl String?

  founderGoal String?

  bio String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Startup {
  id String @id @default(uuid())

  name String

  website String?

  teamSize Int?

  startupStage String?

  industry String?

  businessModel String?

  problemStatement String?

  solutionOverview String?

  description String?

  founderId String

  founder User @relation("FounderStartups", fields: [founderId], references: [id])

  builder Builder?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([founderId])
}

model Builder {
  id        String @id @default(uuid())

  startupId String @unique

  startup Startup @relation(fields: [startupId], references: [id])

  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}